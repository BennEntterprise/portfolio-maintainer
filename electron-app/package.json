{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc && vite build",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "backlog": "npx backlog browser",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:main": "tsc -w",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development nodemon --exec electron . --watch dist/main --ext js",
    "test:dev": "echo 'Testing hot reload - edit App.tsx and see changes instantly!'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "backlog.md": "^1.6.7",
    "electron": "^36.3.2",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  }
}
